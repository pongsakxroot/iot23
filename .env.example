# Database Configuration
DATABASE_URL=sqlite:///./payment_verification.db
# For PostgreSQL: postgresql://user:password@localhost:5432/promptpay

# API Configuration
API_KEY=your-secure-api-key-here
WEBHOOK_SECRET=your-webhook-secret-here
API_HOST=0.0.0.0
API_PORT=8000

# Order Configuration
ORDER_TTL_MINUTES=10
BASE_AMOUNT_MIN=1.00
BASE_AMOUNT_MAX=999999.99

# MQTT Configuration
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_TRIGGER=device/payment/trigger
MQTT_CLIENT_ID=promptpay-backend

# LINE Notify Configuration (optional)
LINE_NOTIFY_TOKEN=
LINE_NOTIFY_ENABLED=false

# Telegram Configuration (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=false

# Email/IMAP Worker Configuration
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
IMAP_EMAIL=your-email@gmail.com
IMAP_PASSWORD=your-app-password-here
IMAP_POLL_INTERVAL=15
IMAP_MAILBOX=INBOX

# Logging
LOG_LEVEL=INFO
